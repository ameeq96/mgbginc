# MySQL/phpMyAdmin database settings, Laravel-style.
DB_CONNECTION="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="mgbginc"
DB_USERNAME="root"
DB_PASSWORD="your_mysql_password"

# Optional advanced override. Leave empty unless you need a custom Prisma URL.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="https://mgbginc.ca"
ADMIN_EMAIL="admin@mgbginc.ca"
ADMIN_PASSWORD="Admin@12345"
RESET_ADMIN_PASSWORD="false"

# Optional SMTP settings for contact and consultation notifications.
ADMIN_NOTIFY_EMAIL="admin@mgbginc.ca"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MGBG Inc. <no-reply@mgbginc.ca>"
