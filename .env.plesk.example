# Copy these values into Plesk > Node.js > Environment variables.
# Do not upload your real .env file publicly.

NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://mgbginc.ca"

# Plesk MySQL/phpMyAdmin database.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has @, #, :, /, or spaces, URL-encode it.
DATABASE_URL="mysql://mgbg_user:strong_password@localhost:3306/mgbginc"

# Generate a long random value before going live.
JWT_SECRET="replace-with-a-long-random-production-secret"

# First seed admin account. Change before first live seed.
ADMIN_EMAIL="admin@mgbginc.ca"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Optional: set true only when you intentionally want seed to reset the admin password.
RESET_ADMIN_PASSWORD="false"

# Optional SMTP settings for contact/consultation notifications.
ADMIN_NOTIFY_EMAIL="admin@mgbginc.ca"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MGBG Inc. <no-reply@mgbginc.ca>"
